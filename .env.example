# ---------------------------------------------------------------------------
# Midpoint Tech — environment configuration
# Copy to .env (local) or configure equivalent values in your deployment
# platform / Docker secrets for production. Never commit a real .env file.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://tech.mid-point.co.za
SITE_URL=https://tech.mid-point.co.za

# --- Lead delivery -----------------------------------------------------
EMAIL_PROVIDER=log
LEASING_TO_EMAIL=leasing@mid-point.co.za
LEASING_FROM_EMAIL=no-reply@mid-point.co.za
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# --- Rate limiting (form submission abuse protection) -------------------
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=60000

# --- Analytics (optional) ------------------------------------------------
NEXT_PUBLIC_GTM_ID=

# --- Maps -----------------------------------------------------------------
NEXT_PUBLIC_MAPS_EMBED_ENABLED=false

# ---------------------------------------------------------------------------
# Docker / Traefik deployment (see docker-compose.yml and docs/deployment.md)
# ---------------------------------------------------------------------------
APP_DOMAIN=tech.mid-point.co.za
TRAEFIK_NETWORK=traefik-public
LETSENCRYPT_RESOLVER=letsencrypt
