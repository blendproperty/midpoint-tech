# Copy to .env.local for local development, or provide as real
# environment variables / secrets in your deployment platform.

NODE_ENV=development

# Public site URL — used for canonical links, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=https://tech.mid-point.co.za

# Docker / Traefik deployment
APP_DOMAIN=tech.mid-point.co.za
TRAEFIK_NETWORK=traefik-public
LETSENCRYPT_RESOLVER=letsencrypt

# Lead delivery webhook (e.g. CRM inbound webhook, email API, Zapier/Make).
# If unset, leads are only logged server-side (development behaviour).
LEADS_WEBHOOK_URL=

# Analytics (optional)
NEXT_PUBLIC_GTM_ID=

# Maps (optional) — use a PUBLICLY-SCOPED Maps Embed key only.
# Restrict it to your domain in Google Cloud Console. Never use a
# server/API key with broad permissions here.
NEXT_PUBLIC_MAPS_EMBED_KEY=
